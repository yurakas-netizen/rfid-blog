<%- include('partials/head') %>
<%- include('partials/left-sidebar') %>

<main class="main full-width">
  <article class="main-article">
    <header class="article-header">
      <% if (post.imageUrl) { %>
        <div class="article-image">
          <img src="<%= post.imageUrl %>" alt="<%= post.title %>" />
        </div>
      <% } %>
      <div class="article-details">
        <div class="article-category">
          <span class="lang-badge"><%= post.lang %></span>
          <% post.categories.forEach(function(cat) { %>
            <a href="<%= langPrefix %>/categories/<%= encodeURIComponent(slugify(cat)) %>/"><%= cat %></a>
          <% }); %>
        </div>
        <h1 class="article-title"><%= post.title %></h1>
        <% if (post.description) { %>
          <h2 class="article-subtitle"><%= post.description %></h2>
        <% } %>
        <footer class="article-time">
          <div>
            <time datetime="<%= post.date.toISOString() %>"><%= formatDate(post.date, lang) %></time>
          </div>
          <div><%= post.readingTime %> <%= t.minRead %> (<%= post.wordCount %> <%= t.wordsLabel %>)</div>
        </footer>
        <% if (typeof translatedPosts !== 'undefined' && translatedPosts && translatedPosts.length > 0) { %>
          <nav class="article-translations" aria-label="<%= t.languageLabel %>">
            <span class="article-translations__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 5h7"></path>
                <path d="M9 3v2c0 4.418 -2.239 8 -5 8"></path>
                <path d="M5 9c0 2.144 2.952 3.908 6.7 4"></path>
                <path d="M12 20l4 -9l4 9"></path>
                <path d="M19.1 18h-6.2"></path>
              </svg>
            </span>
            <div class="article-translations__list">
              <% translatedPosts.forEach(function(tp) { %>
                <% var tpLangCfg = languagesMap[tp.lang]; var cleanLangName = (tpLangCfg ? tpLangCfg.label : tp.lang).replace(/\s*\([^)]+\)$/, ''); %>
                <a href="<%= tp.permalink %>" class="translation-badge" title="<%= tp.title %>" hreflang="<%= tp.lang %>">
                  <span class="translation-badge__code"><%= tp.lang.toUpperCase() %></span>
                  <span class="translation-badge__name"><%= cleanLangName %></span>
                </a>
              <% }); %>
            </div>
          </nav>
        <% } %>
      </div>
    </header>

    <section class="article-content">
      <%- post.html %>
    </section>

    <footer class="article-footer">
      <% if (post.tags.length > 0) { %>
        <section class="article-tags">
          <% post.tags.forEach(function(tag) { %>
            <a href="<%= langPrefix %>/tags/<%= encodeURIComponent(slugify(tag)) %>/">#<%= tag %></a>
          <% }); %>
        </section>
      <% } %>

      <section class="article-copyright">
        <%= site.license %>
      </section>
    </footer>
  </article>

  <% if (typeof articleSources !== 'undefined' && articleSources && articleSources.length > 0 && typeof sourcesUi !== 'undefined') { %>
    <section class="rfid-sources" aria-labelledby="rfid-sources-title">
      <header class="rfid-sources__head">
        <div class="rfid-sources__head-main">
          <div class="rfid-sources__title-row">
            <span class="rfid-sources__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v5.5c0 4.5 -3.2 7.8 -8 9c-4.8 -1.2 -8 -4.5 -8 -9v-5.5z"/><path d="M9 12l2 2l4 -4"/></svg>
            </span>
            <h2 id="rfid-sources-title" class="rfid-sources__title"><%= sourcesUi.heading %></h2>
          </div>
          <p class="rfid-sources__subtitle"><%= sourcesUi.subtitle %></p>
        </div>
        <span class="rfid-sources__summary"><%= articleSources.length %> <%= sourcesUi.sourcesCountWord %></span>
      </header>

      <div class="rfid-sources__grid">
        <% articleSources.forEach(function(src) { %>
          <a class="rfid-sources__item<%= src.isLocal ? ' is-regional' : '' %>" href="<%= src.url %>" target="_blank" rel="noopener noreferrer">
            <div class="rfid-sources__item-top">
              <span class="rfid-sources__code"><%= src.code %></span>
              <span class="rfid-sources__scope"><%= src.isLocal ? (src.regionCode + ' · ' + sourcesUi.regionalLabel) : sourcesUi.globalLabel %></span>
            </div>
            <p class="rfid-sources__desc"><%= src.desc %></p>
            <div class="rfid-sources__foot">
              <span class="rfid-sources__host"><%= src.host %></span>
              <span class="rfid-sources__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>

  <% if (relatedPosts && relatedPosts.length > 0) { %>
    <section class="related-section">
      <h2 class="widget-title" style="margin-bottom: 0;"><%= t.relatedPosts %></h2>
      <div class="related-grid">
        <% relatedPosts.forEach(function(rp) { %>
          <a href="<%= rp.permalink %>" class="related-card">
            <div class="compact-item-title"><%= rp.title %></div>
            <div class="compact-item-date" style="margin-top: 6px;"><%= formatDate(rp.date, lang) %></div>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>

<%- include('partials/footer') %>
