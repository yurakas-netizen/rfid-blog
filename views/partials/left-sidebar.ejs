<aside class="sidebar left-sidebar">
  <header>
    <div class="sidebar-top-row">
      <a href="<%= langPrefix || '/' %>" class="brand-mark">
        <span class="brand-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 896.41 595.46" role="img" aria-label="RFID Ukraine">
            <path class="logo-primary" d="M175.35,468.61l-59.34-186.01h-38.67v186.01H0V1.9h120.68c70.67,0,117.34,28,117.34,98.67v83.34c0,44.67-18.67,72.67-50.67,86.67l66.67,198.01h-78.67ZM77.34,215.92h40.67c25.34,0,42.67-9.33,42.67-42.67v-60.67c0-33.34-17.33-42.67-42.67-42.67h-40.67v146.01Z"/>
            <path class="logo-primary" d="M295.35,1.9h202.02v68h-124.68v131.34h104.01v68h-104.01v199.35h-77.34V1.9Z"/>
            <path class="logo-primary" d="M538.69,468.61V1.9h77.34v466.7h-77.34Z"/>
            <path class="logo-secondary" d="M59.09,564.97c0,10.27-2.61,17.92-7.84,22.95-5.23,5.03-12.43,7.54-21.61,7.54s-16.27-2.51-21.48-7.54c-5.21-5.03-7.81-12.68-7.81-22.95v-51.32h14.43v51.42c0,6.49,1.21,11.2,3.63,14.15,2.42,2.95,6.17,4.43,11.23,4.43s8.93-1.48,11.37-4.43c2.44-2.95,3.66-7.67,3.66-14.15v-51.42h14.43v51.32Z"/>
            <path class="logo-secondary" d="M176.42,554.58l.38-11.09,32.24,50.77h-15.9l-24.65-39.67,6.67.93-12.41,16.61,1.26-9.13v31.26h-14.37v-80.61h14.37v42.68l-2.73-1.86,30.6-40.82h15.41l-30.88,40.93Z"/>
            <path class="logo-secondary" d="M295.66,594.26v-80.61h31.04c8.12,0,14.23,1.86,18.31,5.57,4.08,3.72,6.12,9.18,6.12,16.39,0,4.23-.8,7.81-2.4,10.77-1.6,2.95-3.55,5.23-5.85,6.83-2.29,1.6-4.48,2.51-6.56,2.73,2.11.15,4.15.69,6.12,1.64,1.97.95,3.58,2.43,4.84,4.45,1.26,2.02,1.89,4.75,1.89,8.17v16.34c0,1.71.15,3.29.44,4.73.29,1.44.66,2.43,1.09,2.98h-14.48c-.36-.66-.68-1.67-.96-3.03-.27-1.37-.41-2.92-.41-4.67v-14.65c0-3.31-.93-5.83-2.79-7.54-1.86-1.71-4.66-2.57-8.42-2.57h-17.76l3.83-4.86v37.33h-14.04ZM309.7,555.73l-3.83-5.41h17.87c2.37,0,4.5-.55,6.39-1.67,1.89-1.11,3.4-2.67,4.51-4.67,1.11-2,1.67-4.35,1.67-7.05,0-3.93-1.13-6.89-3.39-8.85-2.26-1.97-5.46-2.95-9.62-2.95h-17.82l4.21-5.08v35.68Z"/>
            <path class="logo-secondary" d="M436.65,594.26l20.82-80.72h22.73l20.66,80.72h-14.81l-17.27-71.81h.11l-17.43,71.81h-14.81ZM450.09,574.64v-11.53h37.49v11.53h-37.49Z"/>
            <path class="logo-secondary" d="M587.42,594.26v-80.61h14.21v80.61h-14.21Z"/>
            <path class="logo-secondary" d="M706.34,594.26h-13.99v-80.61h22.57l29.46,74.76-2.13.6v-75.36h14.04v80.61h-22.9l-29.35-74.59,2.3-.55v75.14Z"/>
            <path class="logo-secondary" d="M854.82,525.13l6.5-7.16v34.43l-3.39-4.32h30.17v11.48h-30.17l3.39-4.26v34.65l-6.5-7.16h39.35v11.48h-47.33v-80.61h47.33v11.48h-39.35Z"/>
            <path class="logo-accent" d="M779.07,0h-119.34v69.93h124.42c27.79,3.38,34.23,18.06,35.32,44.2v243.8c-1.32,31.13-15.1,41.44-37.89,42.43l-44.08.16.02-271.95h24.58s-.29,168.47,0,247.18h12.86c11.84-1.17,18.15-8.71,19.3-19.72v-227.46c-.69-14.9-3.45-32.33-32.16-34.11h-102.34l-.03,372.24h119.34c70.67,0,117.34-28,117.34-98.67V98.67c0-70.67-46.67-98.67-117.34-98.67Z"/>
          </svg>
        </span>
        <div class="site-meta">
          <h1 class="site-name"><%= langConfig.title %></h1>
        </div>
      </a>
      <button id="toggle-menu" class="hamburger" type="button" aria-label="Toggle Menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="site-meta">
      <h2 class="site-description"><%= t.subtitle %></h2>
    </div>
  </header>

  <ol class="menu" id="main-menu">
    <li class="<%= activeNav === 'home' ? 'current' : '' %>">
      <a href="<%= langPrefix || '/' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12l-2 0l9 -9l9 9l-2 0"></path>
          <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7"></path>
          <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6"></path>
        </svg>
        <span><%= t.home %></span>
      </a>
    </li>

    <li class="<%= activeNav === 'archives' ? 'current' : '' %>">
      <a href="<%= langPrefix %>/archives/">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 4m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
          <path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-10"></path>
          <path d="M10 12l4 0"></path>
        </svg>
        <span><%= t.archives %></span>
      </a>
    </li>

    <li class="<%= activeNav === 'search' ? 'current' : '' %>">
      <a href="<%= langPrefix %>/search/">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
          <path d="M21 21l-6 -6"></path>
        </svg>
        <span><%= t.search %></span>
      </a>
    </li>

    <li class="<%= activeNav === 'links' ? 'current' : '' %>">
      <a href="<%= langPrefix %>/links/">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 15l6 -6"></path>
          <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464"></path>
          <path d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463"></path>
        </svg>
        <span><%= t.links %></span>
      </a>
    </li>

    <li>
      <a href="/admin/">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z"></path>
          <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
        </svg>
        <span><%= t.adminCms %></span>
      </a>
    </li>

    <li class="menu-bottom-section">
      <div class="i18n-switcher">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5h7"></path>
          <path d="M9 3v2c0 4.418 -2.239 8 -5 8"></path>
          <path d="M5 9c0 2.144 2.952 3.908 6.7 4"></path>
          <path d="M12 20l4 -9l4 9"></path>
          <path d="M19.1 18h-6.2"></path>
        </svg>
        <select id="language-select" aria-label="<%= t.languageLabel %>">
          <% orderedLanguages.forEach(function(l) { %>
            <option value="<%= l.urlPrefix || '/' %>" <%= l.code === lang ? 'selected' : '' %>>
              <%= l.label %><%= langPostCounts[l.code] ? ' (' + langPostCounts[l.code] + ')' : '' %>
            </option>
          <% }); %>
        </select>
      </div>

      <% if (site.colorSchemeToggle) { %>
        <button id="dark-mode-toggle" class="color-scheme-toggle" type="button" data-dark-label="<%= t.darkMode %>" data-light-label="<%= t.lightMode %>">
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
            <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"></path>
          </svg>
          <svg class="icon-moon" style="display:none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"></path>
          </svg>
          <span class="toggle-label"><%= t.lightMode %></span>
        </button>
      <% } %>
    </li>
  </ol>
</aside>
