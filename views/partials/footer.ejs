<footer class="site-footer">
  <div class="footer-contacts">
    <a href="<%= site.contacts.phoneHref %>" class="footer-contact-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2"/></svg>
      <span><%= site.contacts.phoneDisplay %></span>
    </a>
    <a href="mailto:<%= site.contacts.email %>" class="footer-contact-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
      <span><%= site.contacts.email %></span>
    </a>
    <span class="footer-contact-item">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z"/></svg>
      <span><%= t.city %></span>
    </span>
  </div>
  <section class="copyright">
    &copy; <%= site.footerSince %> - <%= new Date().getFullYear() %> <%= site.shortTitle %>
  </section>
  <section class="powerby">
    <%= t.subtitle %> · <%= site.license %>
  </section>
</footer>
</main>
<%- include('right-sidebar') %>
</div>

