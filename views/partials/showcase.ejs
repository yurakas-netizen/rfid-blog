<%
  const cfg = showcase.config;
  const hero = cfg.hero;
%>
<div class="rfid-showcase">
  <section class="sc-hero">
    <% if (hero.eyebrow) { %>
      <div class="sc-hero__eyebrow"><%= hero.eyebrow %></div>
    <% } %>
    <h2 class="sc-hero__title"><%= hero.title %></h2>
    <% if (hero.subtitle) { %>
      <p class="sc-hero__subtitle"><%= hero.subtitle %></p>
    <% } %>
    <div class="sc-hero__actions">
      <% if (hero.primaryCtaLabel) { %>
        <a class="sc-btn sc-btn--primary" href="<%= hero.primaryCtaUrl %>"><%= hero.primaryCtaLabel %></a>
      <% } %>
      <% if (hero.secondaryCtaLabel && hero.secondaryCtaUrl) { %>
        <a class="sc-btn sc-btn--secondary" href="<%= hero.secondaryCtaUrl %>"><%= hero.secondaryCtaLabel %></a>
      <% } %>
    </div>
    <% if (hero.metrics && hero.metrics.length > 0) { %>
      <div class="sc-hero__metrics">
        <% hero.metrics.forEach(function(m) { %>
          <div class="sc-metric">
            <span class="sc-metric__val"><%= m.value %></span>
            <span class="sc-metric__lbl"><%= m.label %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </section>

  <% if (showcase.totalLangPosts === 0) { %>
    <section class="sc-empty-branch">
      <h3 class="sc-empty-branch__title"><%= showcaseEmptyCopy.emptyBranchTitle %></h3>
      <p class="sc-empty-branch__desc"><%= showcaseEmptyCopy.emptyBranchDesc %></p>
      <% if (showcase.populatedLangs.length > 0) { %>
        <div class="sc-empty-branch__links">
          <% showcase.populatedLangs.forEach(function(pl) { %>
            <a class="sc-lang-jump" href="<%= pl.urlPrefix %>">
              <span><%= pl.label %></span>
              <span class="sc-lang-jump__count"><%= pl.count %></span>
            </a>
          <% }); %>
        </div>
      <% } %>
    </section>
  <% } else { %>
    <% if (cfg.featured.enabled && showcase.leadPost) { %>
      <section class="sc-section">
        <header class="sc-section__head">
          <div>
            <h2 class="sc-section__title"><%= cfg.featured.heading %></h2>
            <% if (cfg.featured.subtitle) { %>
              <p class="sc-section__sub"><%= cfg.featured.subtitle %></p>
            <% } %>
          </div>
        </header>
        <%- include('showcase-card', { post: showcase.leadPost, variant: 'lead', existingImagesMap: showcase.existingImagesMap }) %>
        <% if (showcase.secondaryPosts.length > 0) { %>
          <div class="sc-grid sc-grid--2">
            <% showcase.secondaryPosts.forEach(function(sp) { %>
              <%- include('showcase-card', { post: sp, variant: 'standard', existingImagesMap: showcase.existingImagesMap }) %>
            <% }); %>
          </div>
        <% } %>
      </section>
    <% } %>

    <% showcase.tracks.forEach(function(track) { %>
      <% if (track.posts && track.posts.length > 0) { %>
        <section class="sc-section"<%= track.layout !== 'compact' ? ' data-sc-carousel' : '' %>>
          <header class="sc-section__head">
            <div>
              <h2 class="sc-section__title"><%= track.title %></h2>
              <% if (track.description) { %>
                <p class="sc-section__sub"><%= track.description %></p>
              <% } %>
            </div>
            <div class="sc-section__actions">
              <% if (track.layout !== 'compact' && track.posts.length > 1) { %>
                <div class="sc-carousel__nav" hidden>
                  <button type="button" class="sc-carousel__btn" data-sc-prev aria-label="Previous">&#8249;</button>
                  <span class="sc-carousel__counter" data-sc-counter></span>
                  <button type="button" class="sc-carousel__btn" data-sc-next aria-label="Next">&#8250;</button>
                </div>
              <% } %>
              <% if (track.linkLabel) { %>
                <a class="sc-section__more" href="<%= track.resolvedLinkUrl %>"><%= track.linkLabel %> &rarr;</a>
              <% } %>
            </div>
          </header>
          <% if (track.layout === 'compact') { %>
            <div class="sc-compact-list">
              <% track.posts.forEach(function(tp) { %>
                <a class="sc-compact-row" href="<%= tp.permalink %>">
                  <span class="sc-compact-row__title"><%= tp.title %></span>
                  <span class="sc-compact-row__meta">
                    <time datetime="<%= tp.date.toISOString().slice(0, 10) %>"><%= formatDate(tp.date, lang) %></time>
                    <span aria-hidden="true">&middot;</span>
                    <span><%= tp.readingTime %> <%= t.minRead %></span>
                  </span>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <div class="sc-carousel">
              <div class="sc-carousel__viewport">
                <div class="sc-carousel__track">
                  <% track.posts.forEach(function(tp) { %>
                    <div class="sc-carousel__slide">
                      <%- include('showcase-card', { post: tp, variant: 'standard', existingImagesMap: showcase.existingImagesMap }) %>
                    </div>
                  <% }); %>
                </div>
              </div>
              <div class="sc-carousel__dots" data-sc-dots aria-hidden="true"></div>
            </div>
          <% } %>
        </section>
      <% } %>
    <% }); %>

    <% if (cfg.latest.enabled && showcase.latestPosts.length > 0) { %>
      <section class="sc-section">
        <header class="sc-section__head">
          <div>
            <h2 class="sc-section__title"><%= cfg.latest.heading %></h2>
            <% if (cfg.latest.subtitle) { %>
              <p class="sc-section__sub"><%= cfg.latest.subtitle %></p>
            <% } %>
          </div>
          <% if (cfg.latest.archiveLabel) { %>
            <a class="sc-section__more" href="<%= cfg.latest.archiveUrl %>"><%= cfg.latest.archiveLabel %> &rarr;</a>
          <% } %>
        </header>
        <div class="sc-compact-list">
          <% showcase.latestPosts.forEach(function(lp) { %>
            <a class="sc-compact-row" href="<%= lp.permalink %>">
              <span class="sc-compact-row__title"><%= lp.title %></span>
              <span class="sc-compact-row__meta">
                <time datetime="<%= lp.date.toISOString().slice(0, 10) %>"><%= formatDate(lp.date, lang) %></time>
                <span aria-hidden="true">&middot;</span>
                <span><%= lp.readingTime %> <%= t.minRead %></span>
              </span>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>
  <% } %>

  <% if (cfg.cta.enabled) { %>
    <section class="sc-cta">
      <div class="sc-cta__copy">
        <% if (cfg.cta.eyebrow) { %>
          <div class="sc-cta__eyebrow"><%= cfg.cta.eyebrow %></div>
        <% } %>
        <h2 class="sc-cta__title"><%= cfg.cta.title %></h2>
        <% if (cfg.cta.description) { %>
          <p class="sc-cta__desc"><%= cfg.cta.description %></p>
        <% } %>
      </div>
      <div class="sc-cta__actions">
        <% if (cfg.cta.buttonLabel) { %>
          <a class="sc-btn sc-btn--primary" href="<%= cfg.cta.buttonUrl %>"><%= cfg.cta.buttonLabel %></a>
        <% } %>
        <% if (cfg.cta.secondaryLabel && cfg.cta.secondaryUrl) { %>
          <a class="sc-btn sc-btn--secondary" href="<%= cfg.cta.secondaryUrl %>"><%= cfg.cta.secondaryLabel %></a>
        <% } %>
      </div>
    </section>
  <% } %>
</div>
<script>
(function () {
  var carousels = document.querySelectorAll('[data-sc-carousel]');
  if (!carousels.length) return;

  function createTimeSeed(salt) {
    var now = new Date();
    var ymd = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate();
    var hms = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
    var seed = Math.imul(ymd, 2654435761) ^ Math.imul(hms + 1, 2246822519) ^ Math.imul(now.getMilliseconds() + 1, 3266489917) ^ Math.imul(salt + 1, 1013904223);
    return seed >>> 0;
  }

  function mulberry32(a) {
    return function () {
      a = (a + 0x6d2b79f5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  carousels.forEach(function (section, cIdx) {
    if (section.dataset.scReady === '1') return;
    section.dataset.scReady = '1';

    var track = section.querySelector('.sc-carousel__track');
    var viewport = section.querySelector('.sc-carousel__viewport');
    var nav = section.querySelector('.sc-carousel__nav');
    var prevBtn = section.querySelector('[data-sc-prev]');
    var nextBtn = section.querySelector('[data-sc-next]');
    var counter = section.querySelector('[data-sc-counter]');
    var dotsWrap = section.querySelector('[data-sc-dots]');
    if (!track || !viewport) return;

    var slides = Array.prototype.slice.call(track.children);
    if (slides.length > 1) {
      var rng = mulberry32(createTimeSeed(cIdx));
      for (var i = slides.length - 1; i > 0; i--) {
        var j = Math.floor(rng() * (i + 1));
        var tmp = slides[i];
        slides[i] = slides[j];
        slides[j] = tmp;
      }
      slides.forEach(function (el) { track.appendChild(el); });
    }

    var current = 0;
    var timer = null;

    function getPerView() {
      return window.innerWidth >= 640 ? 2 : 1;
    }

    function getMaxIndex() {
      return Math.max(0, slides.length - getPerView());
    }

    function renderDots(maxIndex) {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      if (maxIndex <= 0) return;
      for (var i = 0; i <= maxIndex; i++) {
        (function (idx) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'sc-carousel__dot' + (idx === current ? ' is-active' : '');
          dot.setAttribute('aria-label', String(idx + 1));
          dot.addEventListener('click', function () { goTo(idx); });
          dotsWrap.appendChild(dot);
        })(i);
      }
    }

    function update() {
      var maxIndex = getMaxIndex();
      if (current > maxIndex) current = maxIndex;
      if (current < 0) current = 0;

      var isStatic = maxIndex === 0;
      section.classList.toggle('is-static', isStatic);
      if (nav) nav.hidden = isStatic;
      if (dotsWrap) dotsWrap.hidden = isStatic;

      if (isStatic) {
        track.style.transform = '';
      } else {
        var targetSlide = slides[current];
        var offset = targetSlide ? targetSlide.offsetLeft : 0;
        track.style.transform = 'translate3d(' + (-offset) + 'px, 0, 0)';
      }

      if (counter && !isStatic) {
        counter.textContent = (current + 1) + ' / ' + (maxIndex + 1);
      }
      if (dotsWrap) {
        var dots = dotsWrap.querySelectorAll('.sc-carousel__dot');
        if (dots.length !== (maxIndex > 0 ? maxIndex + 1 : 0)) {
          renderDots(maxIndex);
        } else {
          dots.forEach(function (d, idx) {
            d.classList.toggle('is-active', idx === current);
          });
        }
      }
    }

    function goTo(nextIdx) {
      var maxIndex = getMaxIndex();
      if (maxIndex <= 0) return;
      if (nextIdx > maxIndex) current = 0;
      else if (nextIdx < 0) current = maxIndex;
      else current = nextIdx;
      update();
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (reducedMotion || getMaxIndex() <= 0) return;
      timer = setInterval(function () {
        if (!document.hidden) goTo(current + 1);
      }, 6500);
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { goTo(current - 1); startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', function () { goTo(current + 1); startAuto(); });

    section.addEventListener('mouseenter', stopAuto);
    section.addEventListener('mouseleave', startAuto);
    section.addEventListener('focusin', stopAuto);
    section.addEventListener('focusout', startAuto);

    var touchStartX = 0;
    viewport.addEventListener('touchstart', function (e) {
      if (e.touches && e.touches.length === 1) touchStartX = e.touches[0].clientX;
      stopAuto();
    }, { passive: true });
    viewport.addEventListener('touchend', function (e) {
      if (!touchStartX || !e.changedTouches || !e.changedTouches.length) return;
      var dx = e.changedTouches[0].clientX - touchStartX;
      touchStartX = 0;
      if (Math.abs(dx) > 40) {
        goTo(dx < 0 ? current + 1 : current - 1);
      }
      startAuto();
    }, { passive: true });

    window.addEventListener('resize', update);
    update();
    startAuto();
  });
})();
</script>
