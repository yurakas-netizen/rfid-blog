<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= langConfig.direction %>" data-scheme="<%= site.colorSchemeDefault %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDescription %>" />
  <meta property="og:type" content="<%= typeof isArticle !== 'undefined' && isArticle ? 'article' : 'website' %>" />
  <link rel="icon" type="image/svg+xml" href="<%= site.favicon %>" />
  <link rel="stylesheet" href="/vendor/katex/katex.min.css" />
  <link rel="stylesheet" href="/vendor/hljs/github-dark.min.css" />
  <link rel="stylesheet" href="/css/stack.css" />
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
    <script type="application/ld+json"><%- jsonLd %></script>
  <% } %>
</head>
<body>
<div class="container main-container">
