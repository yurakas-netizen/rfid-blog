<%- include('partials/head') %>
<%- include('partials/left-sidebar') %>

<main class="main full-width">
  <section class="section-card">
    <h1 class="section-title"><%= typeof sectionTitle !== 'undefined' ? sectionTitle : t.archives %></h1>

    <% if (archivesByYear.length === 0) { %>
      <p><%= t.noResults %></p>
    <% } %>

    <% archivesByYear.forEach(function(grp) { %>
      <div class="archives-group" id="year-<%= grp.year %>">
        <h2 class="archives-year"><%= grp.year %></h2>
        <div class="article-list--compact">
          <% grp.posts.forEach(function(post) { %>
            <a href="<%= post.permalink %>" class="compact-item">
              <span class="compact-item-title"><%= post.title %></span>
              <span class="compact-item-date"><%= formatDate(post.date, lang) %></span>
            </a>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </section>

<%- include('partials/footer') %>
